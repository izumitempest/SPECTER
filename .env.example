# SPECTER configuration — copy to .env and adjust. Never commit .env.
# Spec: §12 (secrets from environment, fail-fast on placeholders in
# production), §13 (deployment), P-12 (auth lifecycle).

# Runtime mode: development | production
# In production, missing/placeholder secrets cause a hard startup failure.
SPECTER_ENV=development

# Where cases, blobs, and the SQLite database live.
SPECTER_DATA_DIR=./specter_data

# Database path (default: <data_dir>/specter.db).
# SPECTER_DB_PATH=

# Access-token lifetime for the web UI (P-12). Integer hours.
SPECTER_TOKEN_TTL_HOURS=8

# JWT secret: `specter init` writes a random 256-bit key to a keyfile
# (0600 permissions). The env variable below overrides the keyfile.
# Required in production when a keyfile is absent.
# SPECTER_JWT_SECRET=

# Carving parameters (§7.1, §9.1, §9.3).
SPECTER_CHUNK_SIZE=4194304      # 4 MiB hash chunks
SPECTER_SCAN_WINDOW=134217728   # 128 MiB scan windows
SPECTER_SAFETY_CAP=52428800     # 50 MiB per-artifact recovery cap
SPECTER_ALIGNMENT=512           # sector alignment filter (0 = off)